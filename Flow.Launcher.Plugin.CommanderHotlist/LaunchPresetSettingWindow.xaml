<Window x:Class="Flow.Launcher.Plugin.CommanderHotlist.LaunchPresetSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Launch Preset"
        Width="550"
        Background="{DynamicResource PopuBGColor}"
        Foreground="{DynamicResource PopupTextColor}"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        KeyDown="WindowKeyDown"
        mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="4"
                        Click="CancelButton_Click"
                        Style="{StaticResource TitleBarCloseButtonStyle}">
                        <Path
                            Width="46"
                            Height="32"
                            Data="M 18,11 27,20 M 18,20 27,11"
                            Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                            StrokeThickness="1">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Margin="26 0 26 12">
                <StackPanel Margin="0 0 0 12">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Launch Preset"
                        TextAlignment="Left" />
                </StackPanel>

                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        Text="Create a named preset with custom command-line arguments for opening folders."
                        TextAlignment="Left"
                        TextWrapping="WrapWithOverflow" />
                    <TextBlock
                        Margin="0 8 0 10"
                        FontSize="14"
                        Text="Use {path} as a placeholder for the selected directory."
                        TextAlignment="Left"
                        TextWrapping="WrapWithOverflow" />
                </StackPanel>

                <StackPanel Margin="0 10 10 0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0" Grid.Column="0"
                            Margin="10 10 10 0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="Command Name:" />
                        <TextBox
                            x:Name="NameBox"
                            Grid.Row="0" Grid.Column="1"
                            Height="34"
                            Margin="10 10 10 0"
                            VerticalAlignment="Center"
                            Text="" />

                        <TextBlock
                            Grid.Row="1" Grid.Column="0"
                            Margin="10 10 10 0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="Command Description:" />
                        <TextBox
                            x:Name="DescriptionBox"
                            Grid.Row="1" Grid.Column="1"
                            Height="34"
                            Margin="10 10 10 0"
                            VerticalAlignment="Center"
                            Text="" />

                        <TextBlock
                            Grid.Row="2" Grid.Column="0"
                            Margin="10 10 10 0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="Command Arguments:" />
                        <TextBox
                            x:Name="ArgumentsBox"
                            Grid.Row="2" Grid.Column="1"
                            Height="34"
                            Margin="10 10 10 0"
                            VerticalAlignment="Center"
                            Text="" />
                    </Grid>

                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Border
            Grid.Row="1"
            Background="{DynamicResource PopupButtonAreaBGColor}"
            BorderBrush="{DynamicResource PopupButtonAreaBorderColor}"
            BorderThickness="0 1 0 0">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button
                    x:Name="CancelButton"
                    MinWidth="140"
                    Margin="10 0 5 0"
                    Click="CancelButton_Click"
                    Content="{DynamicResource cancel}" />
                <Button
                    x:Name="ConfirmButton"
                    MinWidth="140"
                    Margin="5 0 10 0"
                    Click="ConfirmButton_Click"
                    Content="{DynamicResource done}"
                    Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
