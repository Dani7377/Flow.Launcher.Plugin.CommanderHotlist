	<UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Flow.Launcher.Plugin" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Images\app.png">
