<UserControl x:Class="Flow.Launcher.Plugin.CommanderHotlist.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="400"
             d:DesignWidth="500"
             mc:Ignorable="d">
    <Grid Margin="{StaticResource SettingPanelMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             Double Commander Section
             ============================================================ -->
        <CheckBox x:Name="DcEnabled" Content="Enable Double Commander"
                  Grid.Row="0" Margin="{StaticResource SettingPanelItemTopBottomMargin}" />

        <Grid Grid.Row="1" Margin="{StaticResource SettingPanelItemTopBottomMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="DC Executable Path:" VerticalAlignment="Center"
                       Margin="{StaticResource SettingPanelItemRightMargin}" Grid.Column="0" />
            <TextBox x:Name="DcExePath" Height="23" VerticalAlignment="Center" Grid.Column="1" />
            <Button x:Name="DcExeBrowse" Content="Browse..." Width="80" Height="35"
                    Margin="{StaticResource SettingPanelItemLeftMargin}" VerticalAlignment="Center" Grid.Column="2" />
        </Grid>

        <Grid Grid.Row="2" Margin="{StaticResource SettingPanelItemTopBottomMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="DC Settings XML Path:" VerticalAlignment="Center"
                       Margin="{StaticResource SettingPanelItemRightMargin}" Grid.Column="0" />
            <TextBox x:Name="DcSettingsPath" Height="23" VerticalAlignment="Center" Grid.Column="1" />
            <Button x:Name="DcSettingsBrowse" Content="Browse..." Width="80" Height="35"
                    Margin="{StaticResource SettingPanelItemLeftMargin}" VerticalAlignment="Center" Grid.Column="2" />
        </Grid>

        <Grid Grid.Row="3" Margin="{StaticResource SettingPanelItemTopBottomMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="DC Additional Arguments:" VerticalAlignment="Center"
                       Margin="{StaticResource SettingPanelItemRightMargin}" Grid.Column="0" />
            <TextBox x:Name="DcAdditionalArgs" Height="23" VerticalAlignment="Center" Grid.Column="1" />
        </Grid>

        <!-- ============================================================
             Total Commander Section
             ============================================================ -->
        <CheckBox x:Name="TcEnabled" Content="Enable Total Commander"
                  Grid.Row="4" Margin="{StaticResource SettingPanelItemTopBottomMargin}" />

        <Grid Grid.Row="5" Margin="{StaticResource SettingPanelItemTopBottomMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="TC Executable Path:" VerticalAlignment="Center"
                       Margin="{StaticResource SettingPanelItemRightMargin}" Grid.Column="0" />
            <TextBox x:Name="TcExePath" Height="23" VerticalAlignment="Center" Grid.Column="1" />
            <Button x:Name="TcExeBrowse" Content="Browse..." Width="80" Height="35"
                    Margin="{StaticResource SettingPanelItemLeftMargin}" VerticalAlignment="Center" Grid.Column="2" />
        </Grid>

        <Grid Grid.Row="6" Margin="{StaticResource SettingPanelItemTopBottomMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="TC Settings INI Path:" VerticalAlignment="Center"
                       Margin="{StaticResource SettingPanelItemRightMargin}" Grid.Column="0" />
            <TextBox x:Name="TcSettingsPath" Height="23" VerticalAlignment="Center" Grid.Column="1" />
            <Button x:Name="TcSettingsBrowse" Content="Browse..." Width="80" Height="35"
                    Margin="{StaticResource SettingPanelItemLeftMargin}" VerticalAlignment="Center" Grid.Column="2" />
        </Grid>

        <Grid Grid.Row="7" Margin="{StaticResource SettingPanelItemTopBottomMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="TC Additional Arguments:" VerticalAlignment="Center"
                       Margin="{StaticResource SettingPanelItemRightMargin}" Grid.Column="0" />
            <TextBox x:Name="TcAdditionalArgs" Height="23" VerticalAlignment="Center" Grid.Column="1" />
        </Grid>
    </Grid>
</UserControl>