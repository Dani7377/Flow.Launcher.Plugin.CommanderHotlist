<UserControl x:Class="Flow.Launcher.Plugin.CommanderHotlist.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="750"
             d:DesignWidth="700"
             mc:Ignorable="d">

    <Grid Margin="{StaticResource SettingPanelMargin}" VerticalAlignment="Top" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOTAL COMMANDER -->
        <CheckBox x:Name="TcEnabled"
                  Grid.Row="0"
                  Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"
                  HorizontalAlignment="Left">
            <TextBlock>
                <Run Text="Enable"/>
                <Run Text="Total Commander" FontWeight="SemiBold"/>
            </TextBlock>
        </CheckBox>

        <Grid Grid.Row="1" Margin="{StaticResource SettingPanelItemRightTopBottomMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Executable Path:" VerticalAlignment="Center"
                       Margin="{StaticResource SettingPanelItemRightMargin}" Grid.Column="0"/>
            <TextBox x:Name="TcExePath" Width="300" Height="23" VerticalAlignment="Center" Grid.Column="1"/>
            <Button x:Name="TcExeBrowse" Content="Select" Width="80" Height="35"
                    Margin="{StaticResource SettingPanelItemLeftMargin}" VerticalAlignment="Center" Grid.Column="2"/>
        </Grid>

        <Grid Grid.Row="2" Margin="{StaticResource SettingPanelItemRightTopBottomMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Settings INI Path (wincmd.ini):" VerticalAlignment="Center"
                       Margin="{StaticResource SettingPanelItemRightMargin}" Grid.Column="0"/>
            <TextBox x:Name="TcSettingsPath" Width="300" Height="23" VerticalAlignment="Center" Grid.Column="1"/>
            <Button x:Name="TcSettingsBrowse" Content="Select" Width="80" Height="35"
                    Margin="{StaticResource SettingPanelItemLeftMargin}" VerticalAlignment="Center" Grid.Column="2"/>
        </Grid>

        <Grid Grid.Row="3" Margin="{StaticResource SettingPanelItemRightTopBottomMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Additional Arguments (optional):" VerticalAlignment="Center"
                       Margin="{StaticResource SettingPanelItemRightMargin}" Grid.Column="0"/>
            <TextBox x:Name="TcAdditionalArgs" Width="300" Height="23" VerticalAlignment="Center" Grid.Column="1"/>
        </Grid>

        <!-- TC Launch Presets -->
        <TextBlock Text="Launch Presets"
                   Grid.Row="4"
                   FontWeight="SemiBold"
                   Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"/>

        <ListView
            x:Name="TcPresetsView"
            Grid.Row="5"
            Height="auto"
            Margin="{StaticResource SettingPanelItemTopBottomMargin}"
            BorderBrush="DarkGray"
            BorderThickness="1"
            MouseDoubleClick="TcPresetsView_MouseDoubleClick"
            SizeChanged="ListView_SizeChanged"
            SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding DisplayName}" Header="Command Name" Width="160"/>
                    <GridViewColumn DisplayMemberBinding="{Binding DisplayDescription}" Header="Description" Width="220"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Arguments}" Header="Arguments" Width="220"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="6" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="TcPresetAdd" Content="Add" Width="100"
                    Margin="{StaticResource SettingPanelItemTopBottomMargin}" />
            <Button x:Name="TcPresetEdit" Content="Edit" Width="100"
                    Margin="{StaticResource SettingPanelItemLeftTopBottomMargin}">
                <Button.Style>
                    <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                        <Setter Property="IsEnabled" Value="true" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=TcPresetsView, Path=SelectedItems.Count}" Value="0">
                                <Setter Property="IsEnabled" Value="false" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="TcPresetDelete" Content="Delete" Width="100"
                    Margin="{StaticResource SettingPanelItemLeftTopBottomMargin}" />
        </StackPanel>

        <Separator Grid.Row="7" Style="{StaticResource SettingPanelSeparatorStyle}"/>

        <!-- DOUBLE COMMANDER -->
        <CheckBox x:Name="DcEnabled"
                  Grid.Row="8"
                  Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"
                  HorizontalAlignment="Left">
            <TextBlock>
                <Run Text="Enable"/>
                <Run Text="Double Commander" FontWeight="SemiBold"/>
            </TextBlock>
        </CheckBox>

        <Grid Grid.Row="9" Margin="{StaticResource SettingPanelItemRightTopBottomMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Executable Path:" VerticalAlignment="Center"
                       Margin="{StaticResource SettingPanelItemRightMargin}" Grid.Column="0"/>
            <TextBox x:Name="DcExePath" Width="300" Height="23" VerticalAlignment="Center" Grid.Column="1"/>
            <Button x:Name="DcExeBrowse" Content="Select" Width="80" Height="35"
                    Margin="{StaticResource SettingPanelItemLeftMargin}" VerticalAlignment="Center" Grid.Column="2"/>
        </Grid>

        <Grid Grid.Row="10" Margin="{StaticResource SettingPanelItemRightTopBottomMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Settings XML Path (doublecmd.xml):" VerticalAlignment="Center"
                       Margin="{StaticResource SettingPanelItemRightMargin}" Grid.Column="0"/>
            <TextBox x:Name="DcSettingsPath" Width="300" Height="23" VerticalAlignment="Center" Grid.Column="1"/>
            <Button x:Name="DcSettingsBrowse" Content="Select" Width="80" Height="35"
                    Margin="{StaticResource SettingPanelItemLeftMargin}" VerticalAlignment="Center" Grid.Column="2"/>
        </Grid>

        <Grid Grid.Row="11" Margin="{StaticResource SettingPanelItemRightTopBottomMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Additional Arguments (optional):" VerticalAlignment="Center"
                       Margin="{StaticResource SettingPanelItemRightMargin}" Grid.Column="0"/>
            <TextBox x:Name="DcAdditionalArgs" Width="300" Height="23" VerticalAlignment="Center" Grid.Column="1"/>
        </Grid>

        <!-- DC Launch Presets -->
        <TextBlock Text="Launch Presets"
                   Grid.Row="12"
                   FontWeight="SemiBold"
                   Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"/>

        <ListView
            x:Name="DcPresetsView"
            Grid.Row="13"
            Height="auto"
            Margin="{StaticResource SettingPanelItemTopBottomMargin}"
            BorderBrush="DarkGray"
            BorderThickness="1"
            MouseDoubleClick="DcPresetsView_MouseDoubleClick"
            SizeChanged="ListView_SizeChanged"
            SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding DisplayName}" Header="Command Name" Width="160"/>
                    <GridViewColumn DisplayMemberBinding="{Binding DisplayDescription}" Header="Description" Width="220"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Arguments}" Header="Arguments" Width="220"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="14" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="DcPresetAdd" Content="Add" Width="100"
                    Margin="{StaticResource SettingPanelItemTopBottomMargin}" />
            <Button x:Name="DcPresetEdit" Content="Edit" Width="100"
                    Margin="{StaticResource SettingPanelItemLeftTopBottomMargin}">
                <Button.Style>
                    <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                        <Setter Property="IsEnabled" Value="true" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=DcPresetsView, Path=SelectedItems.Count}" Value="0">
                                <Setter Property="IsEnabled" Value="false" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button x:Name="DcPresetDelete" Content="Delete" Width="100"
                    Margin="{StaticResource SettingPanelItemLeftTopBottomMargin}" />
        </StackPanel>

        <Separator Grid.Row="15" Style="{StaticResource SettingPanelSeparatorStyle}"/>

        <!-- GENERAL -->
        <TextBlock Text="General" FontWeight="SemiBold"
                   Grid.Row="16" Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"/>

        <CheckBox x:Name="ShowSubmenuNames" Content="Show submenu hierarchy in results"
                  Grid.Row="17" Margin="{StaticResource SettingPanelItemRightTopBottomMargin}"
                  HorizontalAlignment="Left"/>
    </Grid>
</UserControl>
